# App Config
PROJECT_NAME="Enterprise Products API"
API_V1_STR="/api/v1"

# Security
SECRET_KEY="enterprise-super-secret-key-change-in-production-32-chars-min"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM="HS256"

# Database (Configured for local Postgres container)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="postgres"
